{
  "manifest_version": 3,
  "name": "JaTubePlayer Chrome Extension",
  "version": "2.3",
  "permissions": ["contextMenus", "notifications", "storage"],
  "host_permissions": ["http://localhost/*"],
  "icons": {
    "128": "jtp_icon.png"
  },
  "action": {
    "default_title": "JaTubePlayer settings",
    "default_popup": "options.html",
    "default_icon": "jtp_icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "chrome_ext.js"
  }
}
